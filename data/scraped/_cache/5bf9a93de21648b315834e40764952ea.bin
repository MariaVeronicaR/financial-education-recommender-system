     >

      <div class="dot-animation " 
      data-content-embedded-app-id="779" 
      >
  
  <div class="js--vue-component js--my-savings-calculator" id="my-savings-calculator-10660698">
  <my-savings-calculator title="Acumulación de capital para un objetivo"
                          summary="Esta herramienta te permite conocer cuánto dinero podrás acumular en un determinado plazo si ahorras mensualmente una cantidad de dinero."
                          bg-image="/assets/bg_ahorros-f9db9f9fbbd99afffc2cc09f281f9dae8958ac0a5c133febf639134f1620b376.jpg"
                          footer-info="* Ejemplo meramente didáctico. No se tienen en cuenta la inflación y otras variables. Se considera una liquidación mensual de intereses y se ha utilizado el método de interés compuesto. Puede consultar la fiscalidad de los productos en el bloque &quot;La oferta de servicios y productos financieros&quot;."
                          inline-template>
    <div class="c-calculator__my_savings">
      <div class="c-box__herramienta">
        <div class="c-herramienta__title" :style="backgroundImage">
          <p><span class="u-h2">{{ title }}</span></p>
        </div>

        <p v-if="summary">{{ summary }}</p>

        <div class="c-form">
          <div class="row">
            <div class="col col-sm-12 col-md-6">
              <div class="form-group">
                <label class="form-label" for="mc_aportacion"><i class="u-secondary--color fas fa-money-bill" aria-hidden="true"></i> ¿Cuánto dinero quieres ahorrar cada mes? (&euro;)</label>
                <input class="form-control" type="number" name="mc_aportacion" id="mc_aportacion" v-model="mc_aportacion" />
              </div>
            </div>

            <div class="col col-sm-12 col-md-6">
              <div class="form-group">
                <label class="form-label" for="mc_interes"><i class="u-primary--color fas fa-address-card" aria-hidden="true"></i> Tipo de interés (%)</label>
                <input class="form-control" type="number" name="mc_interes" id="mc_interes" v-model="mc_interes" />
              </div>
            </div>
          </div>

          <div class="form-group row">
            <div class="col col-sm-12 col-md-6">
                <label class="form-label" for="mc_capital"><i class="u-secondary--color fas fa-money-bill" aria-hidden="true"></i> ¿Cuánto dinero tienes ya ahorrado? (&euro;)</label>
                <input class="form-control" type="number" name="mc_capital" id="mc_capital" v-model="mc_capital" />
            </div>

            <div class="col col-sm-12 col-md-6">
                <div>
                  <label class="form-label" for="mc_impositivo"><i class="u-primary--color fas fa-address-card" aria-hidden="true"></i> Tipo impositivo (%)</label>
                  <button class="c-box__tooltip" type="button" data-toggle="modal" data-target="#tooltipMySavingsImpositivo">
  <i class="fas fa-question" aria-hidden="true"></i> <span class="sr-only">Abrir ventana modal con más información</span>
</button>
                </div>
                <input class="form-control" type="number" name="mc_impositivo" id="mc_impositivo" v-model="mc_impositivo" />
            </div>
          </div>

          <div class="row">
            <div class="col col-sm-12 col-md-6">
              <div class="form-group">
                <label class="form-label" for="mc_numAnyos"><i class="u-primary--color fas fa-address-card" aria-hidden="true"></i> ¿Cuánto dinero tendré ahorrado? (Años)</label>
                <input class="form-control" type="number" name="mc_numAnyos" id="mc_numAnyos" v-model="mc_numAnyos" />
              </div>
            </div>
          </div>


          <div class="form-group u-align--right">
            <button class="c-button__transparent" @click="calculate()">
              <span v-if="!total">Calcular</span>
              <span v-else><i class="fas fa-redo-alt" aria-hidden="true"></i> Calcular de nuevo</span>
            </button>
          </div>
        </div>

        <div class="c-budget__result" aria-live="polite" v-show="total">
          <h2>Resultados</h2>

          <p v-html="message"></p>
          <div class="c-budget__result--content">
            <canvas :id="app_id" role="img" style="min-width: 100%; min-height: 300px;" role="img"></canvas>
          </div>
        </div>
      </div>

      <div class="c-modal c-modal--tooltip modal fade" id="tooltipMySavingsImpositivo" tabindex="-1" role="dialog" aria-labelledby="tooltipMySavingsImpositivo" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
          <i class="fas fa-times" aria-hidden="true"></i> <span class="sr-only">Cerrar</span>
        </button>
      </div>
      
      <div class="modal-body">
        <p>* Tasa impositiva a la que están sujetos los rendimientos obtenidos por el capital. Al hacer la declaración de la renta en la base imponible del ahorro los primeros 6.000 euros recibidos en tributan al 19%, los siguientes 44.000 al 21%. Los próximos 150.000 lo hacen al 23% y lo que exceda de 200.000 euros al 26%.</p>
      </div>
    </div>
  </div>
</div>
      <p v-if="footerInfo"><small><em>{{ footerInfo }}</em></small></p>
    </div>
  </my-savings-calculator>
</div>

</div>

</div>
  </div>
</div>


</section>


                <source media="(min-width: 768px)" srcset="/content/dam/santander-com/es/stories/cabecera/2022/-educación-financiera/im-storie-que-es-el-pib-y-por-que-es-importante-en-la-economia-1.jpg.transform/rendition-md/image.jpg"/>
                <source media="(min-width: 400px)" srcset="/content/dam/santander-com/es/stories/cabecera/2022/-educación-financiera/im-storie-que-es-el-pib-y-por-que-es-importante-en-la-economia-1.jpg.transform/rendition-sm/image.jpg"/>
                <source media="(min-width: 0px)" srcset="/content/dam/santander-com/es/stories/cabecera/2022/-educación-financiera/im-storie-que-es-el-pib-y-por-que-es-importante-en-la-economia-1.jpg.transform/rendition-xs/image.jpg"/>
                
                
                    <img src="/content/dam/santander-com/es/stories/cabecera/2022/-educación-financiera/im-storie-que-es-el-pib-y-por-que-es-importante-en-la-economia-1.jpg.transform/rendition-lg/image.jpg" alt/>
                

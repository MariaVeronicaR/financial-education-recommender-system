  <div class="js--vue-component js--budget-calculator" id="budget-calculator-40527505">
  <budget-calculator title="Calcula tu presupuesto"
                     bg-image="/assets/bg_herramientas1-6a671b4dbd55c9876607a2051c2aa40280643bd00633d6883b47304fccb25c8c.jpg"
                     footer-info="" inline-template>

    <div class="c-budget">
      <div class="c-box__herramienta">
        <div v-if="title" class="c-herramienta__title" :style="backgroundImage">
          <p><span class="u-h2">{{ title }}</span></p>
        </div>

        <p v-if="summary">{{ summary }}</p>

        <div class="c-budget__row">
          <div class="c-budget__left col col-12 col-md-8">
            <ul class="c-budget__tabs" role="tablist">
              <li :class="selectedTab == 'savings' ? 'sel' : ''">
                <button @click.prevent.stop="setTab('savings')" tabindex="0" role="tab" :aria-selected="selectedTab == 'savings' ? 'true' : 'false'" aria-controls="budget_savings">{{ saving.title }}</button>
              </li>

              <li :class="selectedTab == 'fixedExpenses' ? 'sel' : ''">
                <button @click.prevent.stop="setTab('fixedExpenses')" tabindex="0" role="tab" :aria-selected="selectedTab == 'fixedExpenses' ? 'true' : 'false'" aria-controls="budget_fixed_expenses">{{ fixedExpenses.title }}</button>
              </li>

              <li :class="selectedTab == 'variableExpenses' ? 'sel' : ''">
                <button @click.prevent.stop="setTab('variableExpenses')" tabindex="0" role="tab" :aria-selected="selectedTab == 'variableExpenses' ? 'true' : 'false'" aria-controls="budget_variable_expenses">{{ variableExpenses.title }}</button>
              </li>

              <li :class="selectedTab == 'discretionaryExpenses' ? 'sel' : ''">
                <button @click.prevent.stop="setTab('discretionaryExpenses')" tabindex="0" role="tab" :aria-selected="selectedTab == 'discretionaryExpenses' ? 'true' : 'false'" aria-controls="budget_discretionary_expenses">{{ discretionaryExpenses.title }}</button>
              </li>
            </ul>

            <ul class="c-budget__tabs_select" :class="openBudgetSelect ? 'open' : ''"
                role="tablist" 
                v-model="selectedTab" 
                @click="openBudgetSelect = !openBudgetSelect">
              <li class="selected">{{ selectedTabTitle }}</li>
              <li><a href="#" @click.prevent.stop="setTab('savings')" role="tab" :aria-selected="selectedTab == 'savings' ? 'true' : 'false'" aria-controls="budget_savings">{{ saving.title }}</a></li>
              <li><a href="#" @click.prevent.stop="setTab('fixedExpenses')" role="tab" :aria-selected="selectedTab == 'fixedExpenses' ? 'true' : 'false'" aria-controls="budget_fixed_expenses">{{ fixedExpenses.title }}</a></li>
              <li><a href="#" @click.prevent.stop="setTab('variableExpenses')" role="tab" :aria-selected="selectedTab == 'variableExpenses' ? 'true' : 'false'" aria-controls="budget_variable_expenses">{{ variableExpenses.title }}</a></li>
              <li><a href="#" @click.prevent.stop="setTab('discretionaryExpenses')" role="tab" :aria-selected="selectedTab == 'discretionaryExpenses' ? 'true' : 'false'" aria-controls="budget_discretionary_expenses">{{ discretionaryExpenses.title }}</a></li>
            </ul>

            <div class="c-budget__tab" id="budget_savings" v-show="selectedTab == 'savings'">
              <div class="c-budget__collapse" :class="[category.color_tag, category.collapsed ? 'c-budget__collapsed' : '']" v-for="(category, catIndex) in saving.categories">
                <div class="c-budget__row c-budget__data">
                  <a href="#" @click.prevent.stop="category.collapsed = !category.collapsed" role="button" :aria-expanded="!category.collapsed ? 'true' : 'false'">
                    <span class="icon" v-html="category.icon_tag"></span>
                    {{ category.title }}
                  </a>
                  <span class="c-budget__total">{{ category.total }}</span>
                  <span>&nbsp;</span>
                  <span class="collapse">Collapse</span>
                </div>

                <div class="c-budget__row" v-for="(expense, index) in category.expenses" :key="index">
                  <span><span class="icon" v-html="expense.icon_tag"></span> {{ expense.title}}</span>
                  <div class="c-content-elements">
                    <label :for="'expense_total_' + catIndex + '_' + index" class="form-label sr-only">Cantidad a ahorrar en &euro;</label>
                    <input type="number" :name="'expense_total_' + catIndex + '_' + index" :id="'expense_total_' + catIndex + '_' + index" v-model="expense.total" @keyup="calculateCategory(category, saving)" min="0" />

                    <label :for="'expense_time_' + catIndex + '_' + index" class="form-label sr-only">Periodicidad</label>
                    <select v-model="expense.time" @change="calculateCategory(category, saving)" :name="'expense_time_' + catIndex + '_' + index" :id="'expense_time_' + catIndex + '_' + index">
                      <option value="31">Diario</option>
                      <option value="4.2856">Semanal</option>
                      <option value="1">Mensual</option>
                      <option value="0.5">Bimensual</option>
                      <option value="0.3333">Trimestral</option>
                      <option value="0.1666">Semestral</option>
                      <option value="0.0833">Anual</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="c-budget__tab" id="budget_fixed_expenses" v-show="selectedTab == 'fixedExpenses'">
              <div class="c-budget__collapse" :class="[category.color_tag, category.collapsed ? 'c-budget__collapsed' : '']" v-for="(category, catIndex) in fixedExpenses.categories" :class="category.collapsed ? 'c-budget__collapsed' : ''">
                <div class="c-budget__row c-budget__data">
                  <a href="#" @click.prevent.stop="category.collapsed = !category.collapsed" role="button" :aria-expanded="!category.collapsed ? 'true' : 'false'">
                    <span class="icon" v-html="category.icon_tag"></span>
                    {{ category.title }}
                  </a>
                  <span class="c-budget__total">{{ category.total }}</span>
                  <span>&nbsp;</span>
                  <span class="collapse">Collapse</span>
                </div>

                <div class="c-budget__row" v-for="(expense, index) in category.expenses" :key="index">
                  <span><span class="icon" v-html="expense.icon_tag"></span> {{ expense.title}}</span>
                  <div class="c-content-elements">
                    <label :for="'fixed_expense_total_' + catIndex + '_' + index" class="form-label sr-only">Cantidad a ahorrar en &euro;</label>
                    <input type="number" :name="'fixed_expense_total_' + catIndex + '_' + index" :id="'fixed_expense_total_' + catIndex + '_' + index" v-model="expense.total" @keyup="calculateCategory(category, fixedExpenses)" min="0" />
                    <label :for="'fixed_expense_time_' + catIndex + '_' + index" class="form-label sr-only">Periodicidad</label>
                    <select v-model="expense.time" @change="calculateCategory(category, fixedExpenses)" :name="'fixed_expense_time_' + catIndex + '_' + index" :id="'fixed_expense_time_' + catIndex + '_' + index">
                      <option value="31">Diario</option>
                      <option value="4.2856">Semanal</option>
                      <option value="1">Mensual</option>
                      <option value="0.5">Bimensual</option>
                      <option value="0.3333">Trimestral</option>
                      <option value="0.1666">Semestral</option>
                      <option value="0.0833">Anual</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="c-budget__tab" id="budget_variable_expenses" v-show="selectedTab == 'variableExpenses'">
              <div class="c-budget__collapse" :class="[category.color_tag, category.collapsed ? 'c-budget__collapsed' : '']" v-for="(category, catIndex) in variableExpenses.categories" :class="category.collapsed ? 'c-budget__collapsed' : ''">
                <div class="c-budget__row c-budget__data">
                  <a href="#" @click.prevent.stop="category.collapsed = !category.collapsed" role="button" :aria-expanded="!category.collapsed ? 'true' : 'false'">
                    <span class="icon" v-html="category.icon_tag"></span>
                    {{ category.title }}
                  </a>
                  <span class="c-budget__total">{{ category.total }}</span>
                  <span>&nbsp;</span>
                  <span class="collapse">Collapse</span>
                </div>

                <div class="c-budget__row" v-for="(expense, index) in category.expenses" :key="index">
                  <span><span class="icon" v-html="expense.icon_tag"></span> {{ expense.title}}</span>
                  <div class="c-content-elements">
                    <label :for="'variable_expense_total_' + catIndex + '_' + index" class="form-label sr-only">Cantidad a ahorrar en &euro;</label>
                    <input type="number" :name="'variable_expense_total_' + catIndex + '_' + index" :id="'variable_expense_total_' + catIndex + '_' + index" v-model="expense.total" @keyup="calculateCategory(category, variableExpenses)" min="0" />
                    <label :for="'variable_expense_time_' + catIndex + '_' + index" class="form-label sr-only">Periodicidad</label>
                    <select v-model="expense.time" @change="calculateCategory(category, variableExpenses)" :name="'variable_expense_time_' + catIndex + '_' + index" :id="'variable_expense_time_' + catIndex + '_' + index">
                      <option value="31">Diario</option>
                      <option value="4.2856">Semanal</option>
                      <option value="1">Mensual</option>
                      <option value="0.5">Bimensual</option>
                      <option value="0.3333">Trimestral</option>
                      <option value="0.1666">Semestral</option>
                      <option value="0.0833">Anual</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <div class="c-budget__tab" id="budget_discretionary_expenses" v-show="selectedTab == 'discretionaryExpenses'">
              <div class="c-budget__collapse" :class="[category.color_tag, category.collapsed ? 'c-budget__collapsed' : '']" v-for="(category, catIndex) in discretionaryExpenses.categories" :class="category.collapsed ? 'c-budget__collapsed' : ''">
                <div class="c-budget__row c-budget__data">
                  <a href="#" @click.prevent.stop="category.collapsed = !category.collapsed" role="button" :aria-expanded="!category.collapsed ? 'true' : 'false'">
                    <span class="icon" v-html="category.icon_tag"></span>
                    {{ category.title }}
                  </a>
                  <span class="c-budget__total">{{ category.total }}</span>
                  <span>&nbsp;</span>
                  <span class="collapse">Collapse</span>
                </div>

                <div class="c-budget__row" v-for="(expense, index) in category.expenses" :key="index">
                  <span><span class="icon" v-html="expense.icon_tag"></span> {{ expense.title}}</span>
                  <div class="c-content-elements">
                    <label :for="'discretionary_expense_total_' + catIndex + '_' + index" class="form-label sr-only">Cantidad a ahorrar en &euro;</label>
                    <input type="number" :name="'discretionary_expense_total_' + catIndex + '_' + index" :id="'discretionary_expense_total_' + catIndex + '_' + index" v-model="expense.total" @keyup="calculateCategory(category, discretionaryExpenses)" min="0" />
                    <label :for="'discretionary_expense_time_' + catIndex + '_' + index" class="form-label sr-only">Periodicidad</label>
                    <select v-model="expense.time" @change="calculateCategory(category, discretionaryExpenses)" :name="'discretionary_expense_time_' + catIndex + '_' + index" :id="'discretionary_expense_time_' + catIndex + '_' + index">
                      <option value="31">Diario</option>
                      <option value="4.2856">Semanal</option>
                      <option value="1">Mensual</option>
                      <option value="0.5">Bimensual</option>
                      <option value="0.3333">Trimestral</option>
                      <option value="0.1666">Semestral</option>
                      <option value="0.0833">Anual</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="c-budget__right col col-12 col-md-4">
            <h2>Resultados</h2>

            <div class="c-budget__results" aria-live="polite">
              <ul class="unbullets">
                <li class="d-flex u-secondary--color u-space--between">
                  <span>Ingresos netos</span>
                  <span>{{ formatCurrencyNumber(totalSaving * period) }}</span>
                </li>

                <li class="divider"><hr /></li>

                <li class="d-flex u-black u-space--between">
                  <span>Gastos</span>
                  <span>{{ formatCurrencyNumber(totalBills * period) }}</span>
                </li>

                <li class="d-flex u-rojo u-space--between">
                  <span>Gastos fijos obligatorios</span>
                  <span>{{ formatCurrencyNumber(fixedExpenses.total * period) }}</span>
                </li>

                <li class="d-flex u-morado u-space--between">
                  <span>Gastos variables necesarios</span>
                  <span>{{ formatCurrencyNumber(variableExpenses.total * period) }}</span>
                </li>

                <li class="d-flex u-third--color u-space--between">
                  <span>Gastos discrecionales</span>
                  <span>{{ formatCurrencyNumber(discretionaryExpenses.total * period) }}</span>
                </li>

                <li class="c-difference d-flex u-space--between">
                  <span><strong>Diferencia</strong></span>
                  <span>{{ formatCurrencyNumber(totalDifference * period) }}</span>
                </li>

                <li class="c-difference d-flex u-space--between">
                  <span><label for="period"><strong>Periodicidad</strong></label></span>
                  <div class="c-content-elements">
                    <label class="form-label sr-only" for="period">Periodicidad</label>
                    <select v-model="period" name="period" id="period">
                      <option value="0.0322">Diario</option>
                      <option value="0.2333">Semanal</option>
                      <option value="1">Mensual</option>
                      <option value="2">Bimensual</option>
                      <option value="3">Trimestral</option>
                      <option value="6">Semestral</option>
                      <option value="12">Anual</option>
                    </select>
                  </div>
                </li>
              </ul>

              <canvas :id="app_id"></canvas>
            </div>
          </div>
        </div>

        <div class="c-budget__button">
          <a href="javascript:window.print();" class="c-button__transparent">Imprimir resultados <i class="fas fa-print" aria-hidden="true"></i></a>
        </div>
      </div>

      <p v-if="footerInfo"><small>{{ footerInfo }}</small></p>
    </div>
  </budget-calculator>
</div>

</div>

</div>
  </div>
</div>


</section>

